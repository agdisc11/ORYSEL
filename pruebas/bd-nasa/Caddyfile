# /etc/caddy/Caddyfile on the ORYSEL EC2 instance.
# Caddy gets and renews the Let's Encrypt certificate on its own and sends
# plain HTTP to HTTPS. FastAPI (systemd unit orysel-api) listens only on
# 127.0.0.1:8001, so nothing is served unencrypted to the internet.

orysel.duckdns.org {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:8001
}

# Old links to the bare IP (README, slides) keep working: they jump to HTTPS.
http://184.194.47.119, http://184.194.47.119:8000 {
	redir https://orysel.duckdns.org{uri} permanent
}
